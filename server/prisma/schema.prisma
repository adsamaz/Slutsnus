generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  avatarUrl    String?
  createdAt    DateTime @default(now())

  hostedRooms         Room[]              @relation("HostedRooms")
  roomPlayers         RoomPlayer[]
  leaderboardEntries  LeaderboardEntry[]
  sentFriendships     Friendship[]        @relation("SentFriendships")
  receivedFriendships Friendship[]        @relation("ReceivedFriendships")
  sessionPlayers      GameSessionPlayer[]
  winLossRecords      WinLossRecord[]
  fredagPosts         FredagPost[]
  fredagReactions     FredagReaction[]
  fredagComments      FredagComment[]
  vacationEntries     VacationEntry[]
  vacationHidden      VacationHiddenUser[] @relation("VacationHiddenViewer")
  vacationHiddenBy    VacationHiddenUser[] @relation("VacationHiddenTarget")
  mushroomEntries     MushroomEntry[]
  mushroomAreas       MushroomArea[]
}

model Room {
  id         String   @id @default(cuid())
  code       String   @unique
  gameType   String
  hostId     String
  status     String   @default("waiting")
  maxPlayers Int      @default(2)
  createdAt  DateTime @default(now())

  host     User         @relation("HostedRooms", fields: [hostId], references: [id])
  players  RoomPlayer[]
  sessions GameSession[]
}

model RoomPlayer {
  roomId   String
  userId   String
  ready    Boolean  @default(false)
  joinedAt DateTime @default(now())

  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id])

  @@id([roomId, userId])
}

model GameSession {
  id         String    @id @default(cuid())
  roomId     String
  startTime  DateTime  @default(now())
  endTime    DateTime?
  resultJson String?

  room    Room                @relation(fields: [roomId], references: [id])
  players GameSessionPlayer[]
}

model GameSessionPlayer {
  sessionId String
  userId    String
  score     Int
  rank      Int

  session GameSession @relation(fields: [sessionId], references: [id])
  user    User        @relation(fields: [userId], references: [id])

  @@id([sessionId, userId])
}

model LeaderboardEntry {
  id          String   @id @default(cuid())
  gameType    String
  userId      String
  score       Int
  timeTakenMs Int?
  difficulty  String?
  recordedAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([gameType, score(sort: Desc)])
  @@index([gameType, timeTakenMs(sort: Asc)])
}

model Friendship {
  id          String   @id @default(cuid())
  requesterId String
  addresseeId String
  status      String   @default("pending")
  createdAt   DateTime @default(now())

  requester User @relation("SentFriendships", fields: [requesterId], references: [id])
  addressee User @relation("ReceivedFriendships", fields: [addresseeId], references: [id])

  @@unique([requesterId, addresseeId])
}

model FredagPost {
  id        String   @id @default(cuid())
  userId    String
  type      String   // 'bild' | 'lat' | 'ol'
  fileUrl   String
  caption   String?
  createdAt DateTime @default(now())

  user      User              @relation(fields: [userId], references: [id])
  reactions FredagReaction[]
  comments  FredagComment[]
}

model FredagReaction {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  emoji     String
  createdAt DateTime @default(now())

  post      FredagPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User       @relation(fields: [userId], references: [id])

  @@unique([postId, userId])
}

model FredagComment {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  body      String
  createdAt DateTime @default(now())

  post      FredagPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User       @relation(fields: [userId], references: [id])
}

// Win/loss record per player per game type — upserted on game end (CONTEXT.md locked decision)
model WinLossRecord {
  userId    String
  gameType  String
  wins      Int    @default(0)
  losses    Int    @default(0)

  user User @relation(fields: [userId], references: [id])

  @@id([userId, gameType])
}

model VacationEntry {
  id        String   @id @default(cuid())
  userId    String
  startDate DateTime @db.Date
  endDate   DateTime @db.Date
  icon      String
  title     String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([startDate, endDate])
}

model VacationHiddenUser {
  viewerId     String
  hiddenUserId String
  createdAt    DateTime @default(now())

  viewer     User @relation("VacationHiddenViewer", fields: [viewerId], references: [id])
  hiddenUser User @relation("VacationHiddenTarget", fields: [hiddenUserId], references: [id])

  @@id([viewerId, hiddenUserId])
}

model MushroomEntry {
  id          String   @id @default(cuid())
  userId      String
  areaId      String?
  speciesId   String?
  customLabel String?
  customColor String?
  weightGrams Int
  foundDate   DateTime @db.Date
  lat         Float
  lng         Float
  notes       String?
  visibility  String   @default("private")
  // Only meaningful when visibility === 'friends'; which of the owner's friends can
  // see this entry. Empty by default — an entry set to "friends" is visible to none
  // until the owner explicitly picks recipients.
  visibleToUserIds String[] @default([])
  createdAt   DateTime @default(now())

  user User          @relation(fields: [userId], references: [id])
  area MushroomArea? @relation(fields: [areaId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([areaId, foundDate])
  @@index([foundDate])
  @@index([visibility])
}

model MushroomArea {
  id          String   @id @default(cuid())
  userId      String
  name        String
  polygonJson String
  centerLat   Float
  centerLng   Float
  notes       String?
  visibility  String   @default("private")
  // Only meaningful when visibility === 'friends'; see MushroomEntry.visibleToUserIds.
  visibleToUserIds String[] @default([])
  createdAt   DateTime @default(now())

  user    User            @relation(fields: [userId], references: [id])
  entries MushroomEntry[]

  @@index([userId])
  @@index([visibility])
}
